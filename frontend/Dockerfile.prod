# Production image: a static build served by nginx, which also proxies /api to backend-core
# (see nginx.conf), so the browser talks to a single origin. Used by infra/docker-compose.prod.yml;
# the plain Dockerfile is the Vite dev server used by infra/docker-compose.yml.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Empty = same-origin API calls (src/api.js).
ENV VITE_API_BASE_URL=""
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
