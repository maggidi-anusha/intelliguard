# Copy to infra/.env and fill in. Never commit infra/.env (it is gitignored).

# --- Required ---
# Postgres database, user and password (used by postgres and backend-core).
INTELLIGUARD_DB_NAME=
INTELLIGUARD_DB_USERNAME=
INTELLIGUARD_DB_PASSWORD=
# Password of the ADMIN account backend-core seeds at startup for the simulator (at least 8
# characters). Public registration can't create ADMIN accounts.
INTELLIGUARD_SIMULATOR_ADMIN_PASSWORD=

# --- Optional: simulator ---
# demo (default) | continuous | normal | cascade
INTELLIGUARD_SCENARIO_MODE=
# Blank -> a fresh seed is generated (and logged) on each run.
INTELLIGUARD_SIMULATOR_SEED=

# --- Optional: backend-core (blank = dev defaults) ---
# Base64 HS256 signing key for login tokens, e.g. `openssl rand -base64 48`. Blank -> an
# ephemeral key per start, so tokens stop working after a backend restart (fine for local dev).
INTELLIGUARD_JWT_SECRET=
# Spring profile. Set to prod for a deployment: startup then fails unless
# INTELLIGUARD_JWT_SECRET is set, at least 32 characters and not a placeholder.
INTELLIGUARD_SPRING_PROFILE=
# Browser origins allowed by CORS, comma-separated (default http://localhost:5173).
INTELLIGUARD_CORS_ALLOWED_ORIGINS=
